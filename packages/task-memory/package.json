{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@simpod/opencode-task-memory",
  "version": "0.0.1",
  "private": true,
  "description": "Persistent project findings and task records for OpenCode V2",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./rpc": "./dist/rpc.js"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "bun build.ts",
    "check": "bun run typecheck && bun run test",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "zod": "4.3.6"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.24 <3",
    "@opentui/core": ">=0.5.14",
    "@opentui/solid": ">=0.5.14",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.24",
    "@opencode/theme": "2.0.24",
    "@opentui/core": "0.5.14",
    "@opentui/solid": "0.5.14",
    "@tsconfig/bun": "1.0.9",
    "solid-js": "1.9.12"
  }
}
